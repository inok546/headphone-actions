<!--
    Sizes follow the official estimate: n cells wide ≈ 73n − 16 dp (portrait), m cells high ≈
    66m − 15 dp (landscape). Default 4×1; resizable down to 2×1 and up to 2 rows. The width is not
    capped, so the widget can span the full grid of 4-column home screens.
    Android 12+: no configuration screen when placing the widget (it starts with defaults);
    long press → Settings reconfigures it. Android 11 and lower show the screen when placing.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="io.github.inok546.headphoneactions.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:maxResizeHeight="280dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="110dp"
    android:minWidth="250dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:targetApi="s" />
